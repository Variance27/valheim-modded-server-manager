{
  "name": "valheim-modded-server-manager",
  "version": "1.1.0",
  "description": "Web dashboard that sets up and manages modded Valheim dedicated servers (LinuxGSM + BepInEx + ValheimEnforcer) over SSH",
  "main": "server.js",
  "license": "MIT",
  "author": "JD Quinones (https://github.com/Variance27)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Variance27/valheim-modded-server-manager.git"
  },
  "homepage": "https://github.com/Variance27/valheim-modded-server-manager#readme",
  "bugs": {
    "url": "https://github.com/Variance27/valheim-modded-server-manager/issues"
  },
  "keywords": [
    "valheim",
    "dedicated-server",
    "linuxgsm",
    "bepinex",
    "valheimenforcer",
    "server-manager",
    "dashboard"
  ],
  "scripts": {
    "start": "node server.js",
    "set-password": "node set-password.js",
    "check": "node scripts/check.js",
    "lint": "eslint .",
    "test": "node --test test/*.test.js",
    "test:py": "python3 -m unittest discover -s test -p 'test_*.py'"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.19.2",
    "js-yaml": "^5.4.2",
    "ssh2": "^1.15.0"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "globals": "^15.14.0"
  }
}
